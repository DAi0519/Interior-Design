# 可选：复制为 .env.local 后由启动命令读取；不要把真实密钥写进仓库。
# 也可在连接中心输入，并选择是否由 Canvas Lab 写入 .env.local。
ONEAPI_API_KEY=sk-your-company-api-key

# 可选：默认端口为 4173。
PORT=4173

# 可选：覆盖飞书同步目标。Base Token 与字段 ID 是资源标识，不是 API 密钥。
LARK_BASE_TOKEN=your-base-token
LARK_BASE_URL=https://example.feishu.cn/base/your-base-token
LARK_TABLE_ID=tblxxxxxxxx
LARK_REFERENCE_FIELD_ID=fldxxxxxxxx
LARK_RESULT_FIELD_ID=fldxxxxxxxx
LARK_CLI_PATH=lark-cli

# 可选：覆盖白模渲染读取的 Style DNA 风格库。
LARK_STYLE_BASE_TOKEN=your-style-base-token
LARK_STYLE_TABLE_ID=tblxxxxxxxx

# 可选：覆盖白模渲染读取的 Prompt Agent 配置表。
LARK_AGENT_BASE_TOKEN=your-agent-base-token
LARK_AGENT_TABLE_ID=tblxxxxxxxx

# 可选：覆盖“AI 生图”Base 内的“风格反推prompt”版本表。
LARK_STYLE_DNA_PROMPT_BASE_TOKEN=your-style-dna-prompt-base-token
LARK_STYLE_DNA_PROMPT_TABLE_ID=tblxxxxxxxx
