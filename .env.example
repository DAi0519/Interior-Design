# 可选：复制为 .env.local 后由启动命令读取；不要把真实密钥写进仓库。
# 也可在连接中心输入，并选择是否由 Canvas Lab 写入 .env.local。
ONEAPI_API_KEY=sk-your-company-api-key

# 可选：覆盖“Flux2 Klein”使用的 ComfyUI 服务；浏览器不会读取该地址。
COMFYUI_BASE_URL=http://maas-workflow-app-50-prodtestzwapp50.k8s-zhongwei.qunhequnhe.com/

# 可选：默认端口为 4173。
PORT=4173

# 可选：覆盖飞书同步目标。Base Token 与字段 ID 是资源标识，不是 API 密钥。
LARK_BASE_TOKEN=your-base-token
LARK_BASE_URL=https://example.feishu.cn/base/your-base-token
LARK_TABLE_ID=tblxxxxxxxx
LARK_REFERENCE_FIELD_ID=fldxxxxxxxx
LARK_STYLE_REFERENCE_FIELD_ID=fldxxxxxxxx
LARK_RESULT_FIELD_ID=fldxxxxxxxx
LARK_CLI_PATH=lark-cli

# 可选：覆盖 Beta跑图独立 Base 的样本集、样本与跑图明细三表。
BETA_BASE_TOKEN=your-beta-base-token
BETA_BASE_URL=https://example.feishu.cn/base/your-beta-base-token
BETA_VIEW_ID=your-beta-run-detail-view-id
BETA_SAMPLE_SET_TABLE_ID=tblxxxxxxxx
BETA_SAMPLE_TABLE_ID=tblxxxxxxxx
BETA_SAMPLE_IMAGE_FIELD_ID=fldxxxxxxxx
BETA_TABLE_ID=tblxxxxxxxx
BETA_INPUT_FIELD_ID=fldxxxxxxxx
BETA_STYLE_REFERENCE_FIELD_ID=fldxxxxxxxx
BETA_RESULT_FIELD_ID=fldxxxxxxxx
BETA_TEST_TIME_FIELD_ID=fldxxxxxxxx

# 可选：覆盖白模渲染读取的 Style DNA 风格库。
LARK_STYLE_BASE_TOKEN=your-style-base-token
LARK_STYLE_TABLE_ID=tblxxxxxxxx

# 可选：覆盖白模渲染读取的 Prompt Agent 配置表。
LARK_AGENT_BASE_TOKEN=your-agent-base-token
LARK_AGENT_TABLE_ID=tblxxxxxxxx

# 可选：覆盖“空房设计prompt”双模式 Agent 配置表；正文只由服务端读取。
LARK_EMPTY_ROOM_PROMPT_BASE_TOKEN=your-empty-room-prompt-base-token
LARK_EMPTY_ROOM_PROMPT_TABLE_ID=tblxxxxxxxx

# 可选：覆盖“AI 生图”Base 内的“风格反推prompt”版本表。
LARK_STYLE_DNA_PROMPT_BASE_TOKEN=your-style-dna-prompt-base-token
LARK_STYLE_DNA_PROMPT_TABLE_ID=tblxxxxxxxx

# 可选：覆盖精模渲染固定 Prompt 表；正文只由服务端读取。
LARK_REFINED_PROMPT_BASE_TOKEN=your-refined-prompt-base-token
LARK_REFINED_PROMPT_TABLE_ID=tblxxxxxxxx

# 可选：覆盖效果图美化正向 Prompt 表；正文只由服务端读取。
LARK_EFFECT_ENHANCEMENT_PROMPT_BASE_TOKEN=your-effect-prompt-base-token
LARK_EFFECT_ENHANCEMENT_PROMPT_TABLE_ID=tblxxxxxxxx

# 可选：独立模型横评 Runner 使用的 Base 与五张运行主表。
BENCHMARK_BASE_TOKEN=your-benchmark-base-token
BENCHMARK_SAMPLE_TABLE_ID=tblxxxxxxxx
BENCHMARK_CONFIG_TABLE_ID=tblxxxxxxxx
BENCHMARK_PROMPT_TABLE_ID=tblxxxxxxxx
BENCHMARK_COMPARE_TABLE_ID=tblxxxxxxxx
BENCHMARK_RESULT_TABLE_ID=tblxxxxxxxx

# 可选：Benchmark 实验、类别和 AI 评审版本的当前 worktree 本地状态文件。
BENCHMARK_WORKBENCH_STATE_FILE=.benchmark-workbench/state.json
