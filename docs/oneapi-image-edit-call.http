# [INPUT]: 依据sunburst.10的固定1K/medium实际请求构造；图片与用户指令由调用者替换
# [OUTPUT]: 完整OneAPI调用模板，含无mask蓝色圈选/参考图异步提交与GET查询、涂抹/参考图同步请求
# [POS]: docs/ 的独立开发交接导出，不包含真实密钥或图片；未完成腾讯Sunburst异步路由真实出图验证
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
# 核对日期：2026-10-22。下方size为3:2原图的1K示例；其他比例按交接表换算。
# 本文件是参数模板；替换以下变量后再调用，每次选择一种路径，不要重复POST。
@ONEAPI_API_KEY = REPLACE_WITH_YOUR_KEY
@SOURCE_WITH_SELECTION_PNG_BASE64 = REPLACE_WITH_COMPLETE_SOURCE_PNG_WITH_BLUE_SELECTION_OUTLINE
@SOURCE_PNG_BASE64 = REPLACE_WITH_COMPLETE_SOURCE_PNG_WITHOUT_OVERLAY
@REFERENCE_PNG_BASE64 = REPLACE_WITH_OBJECT_REFERENCE_PNG
@ALPHA_MASK_PNG_BASE64 = REPLACE_WITH_SAME_SIZE_ALPHA_MASK_PNG
@USER_PROMPT = REPLACE_WITH_USER_INSTRUCTION
@RESPONSE_ID = REPLACE_WITH_RESP_ID_FROM_ASYNC_POST

### 第一段：蓝色圈选＋参考图，无mask异步提交；不传mask或editRegion
# 框选、自由圈选或纯指令（仍有原图）均走Responses；纯指令图1不带圈选线，Prompt按实际定位方式拼接。
# 输入顺序：input_text完整指令 → 第一个input_image底图 → 第二个input_image物体参考。
# 提示词模式省略第二个input_image，不要省略完整底图；图片URL保持原PNG data URL，不转换成拼图。
POST https://oneapi.qunhequnhe.com/v1/responses
Authorization: Bearer {{ONEAPI_API_KEY}}
Content-Type: application/json

{
  "model": "gpt-image-2.5-sunburst",
  "background": true,
  "input": [
    {
      "type": "message",
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "Image 1 contains a selected region marked by a temporary blue outline of any shape. The outline is an annotation, not part of the scene. Use the selected region to identify the target object for the user instruction. Follow the requested action, including replacing, removing, adding or modifying the object. The selection identifies the target and is not a hard boundary for editing. Preserve the scene's composition, perspective and lighting, and keep unrelated objects and background unchanged. Remove all blue selection guide marks from the final image and restore the scene beneath them.\nImage 2 is an object reference. If the user instruction calls for using the reference object, use the requested object from image 2 for the selected target in image 1, matching the scene's scale, perspective and lighting. Do not copy image 2's background.\nUser instruction: {{USER_PROMPT}}\nReturn one complete image without blue selection outlines, guide marks, labels or a collage."
        },
        {
          "type": "input_image",
          "image_url": "data:image/png;base64,{{SOURCE_WITH_SELECTION_PNG_BASE64}}"
        },
        {
          "type": "input_image",
          "image_url": "data:image/png;base64,{{REFERENCE_PNG_BASE64}}"
        }
      ]
    }
  ],
  "tools": [
    {
      "type": "image_generation",
      "size": "1536x1024",
      "quality": "medium",
      "n": 1,
      "image_format": "png",
      "response_format": "b64_json"
    }
  ]
}

# 预期提交回执：HTTP 202，{"id":"resp_...","status":"queued"}（也可能in_progress）。
# 取得id后仅GET查询同一任务，每1.5秒一次；提交与查询总等待600秒，不重复POST。
# 本地超时不等于上游已取消，上游可能继续执行或计费；不要据此重新提交。

### 第一段续：查询已提交的异步任务，直到completed
GET https://oneapi.qunhequnhe.com/v1/responses/{{RESPONSE_ID}}
Authorization: Bearer {{ONEAPI_API_KEY}}

# completed时读取output中type=image_generation_call的result（完整PNG的Base64或图片URL）。
# queued/in_progress继续查；failed/cancelled/incomplete明确报错，不能当成成功。
# 示例：{"id":"resp_...","status":"completed","output":[{"type":"image_generation_call","result":"<PNG_BASE64_OR_IMAGE_URL>"}]}

### 第二段：涂抹＋参考图，独立透明PNG遮罩，仍为同步Images edits
# Responses文档未提供透明mask合同，不能把mask塞进异步input/tools。
# 图1不叠加可视蒙版；独立alpha=0编辑、255保护；以下参数与独立mask JSON保持一致。
POST https://oneapi.qunhequnhe.com/v1/images/edits
Authorization: Bearer {{ONEAPI_API_KEY}}
Content-Type: application/json

{
  "model": "gpt-image-2.5-sunburst",
  "images": [
    {
      "image_url": "data:image/png;base64,{{SOURCE_PNG_BASE64}}"
    },
    {
      "image_url": "data:image/png;base64,{{REFERENCE_PNG_BASE64}}"
    }
  ],
  "mask": {
    "image_url": "data:image/png;base64,{{ALPHA_MASK_PNG_BASE64}}"
  },
  "prompt": "Edit image 1 only in the transparent area of the supplied mask. Preserve its composition, perspective, lighting and all protected areas.\nImage 2 is an object reference. Use the requested object from image 2 inside the masked region of image 1, matching the original scene's scale and lighting. Do not copy image 2's background.\nUser instruction: {{USER_PROMPT}}\nReturn one complete image, without borders, labels or a collage.",
  "size": "1536x1024",
  "quality": "medium",
  "n": 1,
  "output_format": "png",
  "response_format": "b64_json"
}
