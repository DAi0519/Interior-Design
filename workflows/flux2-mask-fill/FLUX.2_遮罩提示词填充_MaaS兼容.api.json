{
  "input": {"class_type":"LoadImage","inputs":{"image":"input.png"},"_meta":{"title":"1. 上传原图 / 右键打开遮罩编辑器"}},
  "model": {"class_type":"UNETLoader","inputs":{"unet_name":"flux-2-klein-9b.safetensors","weight_dtype":"default"},"_meta":{"title":"Flux2 Klein 9B / 保留原权重"}},
  "clip": {"class_type":"CLIPLoader","inputs":{"clip_name":"qwen_3_8b.safetensors","type":"flux2","device":"default"},"_meta":{"title":"Qwen3 8B 文本编码器"}},
  "vae": {"class_type":"VAELoader","inputs":{"vae_name":"flux2-vae.safetensors"},"_meta":{"title":"Flux2 VAE"}},
  "fill": {"class_type":"GrowMaskWithBlur","inputs":{"expand":0,"incremental_expandrate":0,"tapered_corners":true,"flip_input":false,"blur_radius":0,"lerp_alpha":1,"decay_factor":1,"fill_holes":true,"mask":["input",1]},"_meta":{"title":"2. 先填遮罩孔洞 / 不膨胀"}},
  "grow": {"class_type":"GrowMaskWithBlur","inputs":{"expand":10,"incremental_expandrate":0,"tapered_corners":true,"flip_input":false,"blur_radius":4,"lerp_alpha":1,"decay_factor":1,"fill_holes":false,"mask":["fill",0]},"_meta":{"title":"3. 遮罩扩展与模糊"}},
  "crop": {"class_type":"InpaintCropImproved","inputs":{"downscale_algorithm":"lanczos","upscale_algorithm":"lanczos","preresize":true,"preresize_mode":"ensure minimum resolution","preresize_min_width":1536,"preresize_min_height":1536,"preresize_max_width":8192,"preresize_max_height":8192,"mask_fill_holes":true,"mask_expand_pixels":0,"mask_invert":false,"mask_blend_pixels":32,"mask_hipass_filter":0.1,"extend_for_outpainting":true,"extend_up_factor":1,"extend_down_factor":1,"extend_left_factor":1,"extend_right_factor":1,"context_from_mask_extend_factor":1.2,"output_resize_to_target_size":true,"output_target_width":1536,"output_target_height":1536,"output_padding":"32","device_mode":"cpu (compatible)","image":["input",0],"mask":["grow",0]},"_meta":{"title":"4. 保留原裁剪 / 上下文 / 回贴合同"}},
  "size": {"class_type":"GetImageSize","inputs":{"image":["crop",1]},"_meta":{"title":"读取实际裁剪尺寸"}},
  "positive": {"class_type":"CLIPTextEncode","inputs":{"clip":["clip",0],"text":"image1: <|vision_start|><|image_pad|><|vision_end|> Remove the refrigerator completely. Fill the masked region with the same plain beige wall and floor as the surrounding area. Leave no refrigerator or other object. Preserve the surrounding room."},"_meta":{"title":"5. 修改末尾编辑指令 / 保留原作者文本前缀"}},
  "negative": {"class_type":"CLIPTextEncode","inputs":{"clip":["clip",0],"text":""},"_meta":{"title":"空负向提示词 / 原 CFG=1"}},
  "encode": {"class_type":"VAEEncode","inputs":{"pixels":["crop",1],"vae":["vae",0]},"_meta":{"title":"编码原图裁剪 / 采样起点"}},
  "positiveMain": {"class_type":"ReferenceLatent","inputs":{"conditioning":["positive",0],"latent":["encode",0]},"_meta":{"title":"正向引用原图潜空间"}},
  "negativeMain": {"class_type":"ReferenceLatent","inputs":{"conditioning":["negative",0],"latent":["encode",0]},"_meta":{"title":"负向引用原图潜空间"}},
  "noiseMask": {"class_type":"SetLatentNoiseMask","inputs":{"samples":["encode",0],"mask":["crop",2]},"_meta":{"title":"6. 以原图 latent 为底 / 仅遮罩采样"}},
  "repeat": {"class_type":"RepeatLatentBatch","inputs":{"samples":["noiseMask",0],"amount":2},"_meta":{"title":"原配置每次生成2张"}},
  "guider": {"class_type":"CFGGuider","inputs":{"model":["model",0],"positive":["positiveMain",0],"negative":["negativeMain",0],"cfg":1},"_meta":{"title":"保留 CFG=1"}},
  "noise": {"class_type":"RandomNoise","inputs":{"noise_seed":123191991266130},"_meta":{"title":"随机种子"}},
  "sampler": {"class_type":"KSamplerSelect","inputs":{"sampler_name":"euler_ancestral"},"_meta":{"title":"保留 Euler Ancestral"}},
  "schedule": {"class_type":"Flux2Scheduler","inputs":{"steps":4,"width":["size",0],"height":["size",1]},"_meta":{"title":"保留4步 / 按真实裁剪尺寸调度"}},
  "sample": {"class_type":"SamplerCustomAdvanced","inputs":{"noise":["noise",0],"guider":["guider",0],"sampler":["sampler",0],"sigmas":["schedule",0],"latent_image":["repeat",0]},"_meta":{"title":"7. Flux2 遮罩采样"}},
  "decode": {"class_type":"VAEDecode","inputs":{"samples":["sample",0],"vae":["vae",0]},"_meta":{"title":"解码生成结果"}},
