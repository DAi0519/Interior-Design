  "fill": {"class_type":"GrowMaskWithBlur","inputs":{"expand":0,"incremental_expandrate":0,"tapered_corners":true,"flip_input":false,"blur_radius":0,"lerp_alpha":1,"decay_factor":1,"fill_holes":true,"mask":["input",1]},"_meta":{"title":"2. 先填遮罩孔洞 / 不膨胀"}},
  "grow": {"class_type":"GrowMaskWithBlur","inputs":{"expand":80,"incremental_expandrate":0,"tapered_corners":true,"flip_input":false,"blur_radius":4,"lerp_alpha":1,"decay_factor":1,"fill_holes":false,"mask":["fill",0]},"_meta":{"title":"3. 遮罩扩展与模糊"}},
  "crop": {"class_type":"InpaintCropImproved","inputs":{"downscale_algorithm":"lanczos","upscale_algorithm":"lanczos","preresize":true,"preresize_mode":"ensure minimum resolution","preresize_min_width":1536,"preresize_min_height":1536,"preresize_max_width":8192,"preresize_max_height":8192,"mask_fill_holes":true,"mask_expand_pixels":0,"mask_invert":false,"mask_blend_pixels":32,"mask_hipass_filter":0.1,"extend_for_outpainting":true,"extend_up_factor":1,"extend_down_factor":1,"extend_left_factor":1,"extend_right_factor":1,"context_from_mask_extend_factor":1.2,"output_resize_to_target_size":true,"output_target_width":1536,"output_target_height":1536,"output_padding":"32","device_mode":"cpu (compatible)","image":["input",0],"mask":["grow",0]},"_meta":{"title":"4. 保留原裁剪 / 上下文 / 回贴合同"}},
  "size": {"class_type":"GetImageSize","inputs":{"image":["crop",1]},"_meta":{"title":"读取实际裁剪尺寸"}},
  "positive": {"class_type":"CLIPTextEncode","inputs":{"clip":["clip",0],"text":"image1: <|vision_start|><|image_pad|><|vision_end|> image2: <|vision_start|><|image_pad|><|vision_end|> 图2的小摆件填充到图1的遮罩区域"},"_meta":{"title":"5. 修改末尾编辑指令 / 保留原作者文本前缀"}},
  "negative": {"class_type":"CLIPTextEncode","inputs":{"clip":["clip",0],"text":""},"_meta":{"title":"空负向提示词 / 原 CFG=1"}},
