  "negativeReference": {"class_type":"ReferenceLatent","inputs":{"conditioning":["negativeMain",0],"latent":["referenceEncode",0]},"_meta":{"title":"负向追加第2张参考"}},
  "noiseMask": {"class_type":"SetLatentNoiseMask","inputs":{"samples":["encode",0],"mask":["crop",2]},"_meta":{"title":"6. 以原图 latent 为底 / 仅遮罩采样"}},
