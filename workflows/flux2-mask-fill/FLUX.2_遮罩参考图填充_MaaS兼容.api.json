  "biref": {"class_type":"RembgByBiRefNet","inputs":{"model":["birefModel",0],"images":["reference",0]},"_meta":{"title":"参考物体前景遮罩 / 白色为物体"}},
  "referenceScale": {"class_type":"LayerUtility: ImageScaleByAspectRatio V2","inputs":{"aspect_ratio":"original","proportional_width":1,"proportional_height":1,"fit":"crop","method":"lanczos","round_to_multiple":"16","scale_to_side":"longest","scale_to_length":1536,"background_color":"#000000","image":["reference",0],"mask":["biref",1]},"_meta":{"title":"参考原图与前景遮罩同步缩放"}},
  "referenceCrop": {"class_type":"LayerUtility: CropByMask V2","inputs":{"invert_mask":false,"detect":"mask_area","top_reserve":128,"bottom_reserve":128,"left_reserve":128,"right_reserve":128,"round_to_multiple":"8","image":["referenceScale",0],"mask":["referenceScale",1]},"_meta":{"title":"保留原参考物体裁剪 / 四边128px"}},
  "referenceCanvas": {"class_type":"ImageScale","inputs":{"image":["referenceCrop",0],"upscale_method":"lanczos","width":["size",0],"height":["size",1],"crop":"center"},"_meta":{"title":"沿用 Painter 的统一尺寸 / 中心裁剪"}},
  "referenceEncode": {"class_type":"VAEEncode","inputs":{"pixels":["referenceCanvas",0],"vae":["vae",0]},"_meta":{"title":"编码参考物体"}},
