{
  "name": "canvas-lab",
  "version": "0.1.24",
  "private": true,
  "type": "module",
  "description": "公司图像模型的本地运营与测试工作台",
  "releaseNotes": [
    "新增户型平面布局：上传户型图、框选主卧并补充需求，先分析空间再生成二维家具布局，默认 GPT Image 2.5 Sunburst。",
    "布局提示词由独立飞书表维护，可选择已上架版本；参数面板、画布和 START 与工作台统一。",
    "原平面布局更名为设计实验室 · Beta；Beta跑图新增户型平面布局，支持逐图标注、多模型对比及飞书归档。"
  ],
  "scripts": {
    "benchmark": "node --env-file-if-exists=.env.local benchmark-runner.mjs",
    "benchmark:backfill": "node --env-file-if-exists=.env.local benchmark-backfill.mjs",
    "lark:init": "lark-cli config init --new",
    "lark:status": "lark-cli auth status --json --verify",
    "release:check": "node scripts/release-check.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@larksuite/cli": "1.0.77",
    "pannellum": "2.5.7",
    "sharp": "0.35.5",
    "undici": "7.30.1"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@larksuite/cli@1.0.77": true
  }
}
