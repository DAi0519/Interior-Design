    "tiers": {
      "1K": {
        "targetPixelArea": 1048576
      },
      "2K": {
        "targetPixelArea": 4194304
      }
    },
    "formula": {
      "aspectRatio": "sourceWidth / sourceHeight",
      "width": "roundTo16(sqrt(targetPixelArea * aspectRatio))",
      "height": "roundTo16(sqrt(targetPixelArea / aspectRatio))"
    },
    "examples": {
      "16:9": {
        "1K": "1360x768",
        "2K": "2736x1536"
